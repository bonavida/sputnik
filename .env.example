# Last.fm API account for scrobbling (https://www.last.fm/api/account/create).
# Copy this file to .env.local (ignored by git) and fill both values. Without them
# the app builds and runs normally, with the Last.fm option hidden.
# In CI they come from the repository secrets of the same name.
LASTFM_API_KEY=
LASTFM_API_SECRET=
