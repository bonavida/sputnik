{
  "name": "sputnik",
  "productName": "Sputnik",
  "version": "2.3.1",
  "description": "A minimalist desktop music player",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "license": "MIT",
  "author": "Diego Bonavida <gecko.bona@gmail.com>",
  "homepage": "https://github.com/bonavida/sputnik",
  "repository": {
    "type": "git",
    "url": "git@github.com:bonavida/sputnik.git"
  },
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --mode web",
    "build": "node scripts/clean.mjs && tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"**/*.int.test.*\"",
    "test:int": "vitest run int.test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "downloads": "node scripts/downloads.mjs",
    "dist": "pnpm build && electron-builder --publish never",
    "dist:win": "pnpm build && electron-builder --win --publish never",
    "dist:mac": "pnpm build && electron-builder --mac --publish never",
    "dist:linux": "pnpm build && electron-builder --linux --publish never"
  },
  "packageManager": "pnpm@10.24.0",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "electron-winstaller"
    ]
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.2",
    "lucide-react": "^1.52.0",
    "music-metadata": "^12.0.0",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-electron": "^1.1.2",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  },
  "engines": {
    "node": ">=24"
  }
}
